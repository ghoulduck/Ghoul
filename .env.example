# ──────────────────────────────────────────────
# Ghoul — required environment variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────

# Anthropic API key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the default Claude model
# GHOUL_MODEL=claude-sonnet-4-20250514

# Optional: GitHub personal access token (increases API rate limits for data collection)
# GITHUB_TOKEN=your_github_token_here

# Optional: HuggingFace token (required for HuggingFace fine-tuning target)
# HF_TOKEN=your_huggingface_token_here

# Optional: HuggingFace base model name for fine-tuning
# HF_MODEL_NAME=mistralai/Mistral-7B-v0.1

# Optional: override the data storage directory (default: ./data)
# GHOUL_DATA_DIR=/path/to/data
